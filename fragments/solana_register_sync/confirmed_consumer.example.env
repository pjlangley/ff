# Runs `confirmed_consumer.ts` locally against the real `ff_dev` resources.
#
# Copy to `confirmed_consumer.env` (gitignored) and replace `<account_id>`; the
# `solana_register_sync:confirmed_consumer` npm script loads that copy if it exists.

# The AWS CLI profile holding the `ff_dev_solana_register_local_runtime` user's access key.
AWS_PROFILE=ff_dev_solana_register_local_runtime
AWS_REGION=eu-west-2

# The dev register instance on devnet (`solana_register_program_id` in `ff_dev/variables.tf`).
SOLANA_REGISTER_PROGRAM_ID=DPEfE7E9LExX61taVQRQHpxZGkFEKLzRqwfCDMtzFg2K
CONFIRMED_QUEUE_URL=https://sqs.eu-west-2.amazonaws.com/<account_id>/ff_dev_solana_register_registrants_confirmed
REGISTRATIONS_TABLE_NAME=ff_dev_solana_register_registrations
HELIUS_RPC_URL_SECRET_ID=ff_dev_solana_register_helius_rpc_url

# Back-to-back polls while testing; remove for the 30-minute default.
POLL_INTERVAL_SECONDS=0
