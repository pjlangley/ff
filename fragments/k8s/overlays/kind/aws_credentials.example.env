# The `ff_dev_solana_register_local_runtime` access key for the KIND overlay's Secret (ADR 016).
#
# Not copied by hand: the README creates the gitignored `aws_credentials.env` from the AWS CLI
# profile, owner-readable only. Never commit it.
AWS_ACCESS_KEY_ID=<access_key_id>
AWS_SECRET_ACCESS_KEY=<secret_access_key>
