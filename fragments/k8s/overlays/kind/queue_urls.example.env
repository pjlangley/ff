# The `ff_dev` queue URLs for the kind overlay's ConfigMap.
#
# Copy to `queue_urls.env` (gitignored) and replace `<account_id>` - the URLs embed the AWS
# account ID, which is never committed.
REGISTRANTS_QUEUE_URL=https://sqs.eu-west-2.amazonaws.com/<account_id>/ff_dev_solana_register_registrants
CONFIRMED_QUEUE_URL=https://sqs.eu-west-2.amazonaws.com/<account_id>/ff_dev_solana_register_registrants_confirmed
