meta {
  name: get registration by index
  type: http
  seq: 5
}

get {
  url: {{base_url}}/solana/register/index/{{REGISTRATION_INDEX}}
}

headers {
  Content-Type: application/json
}

tests {
  test("200 OK - registration found by index", function() {
    const result = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(result.registrant).to.equal(bru.getVar("REGISTRANT_ADDRESS"));
    expect(result.registration_index).to.equal(bru.getVar("REGISTRATION_INDEX"));
    expect(result.registered_at).to.be.ok;
    expect(result.confirmed_at).to.be.null;
  });
}
