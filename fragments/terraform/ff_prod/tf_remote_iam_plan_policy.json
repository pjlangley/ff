{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SqsReadScoped",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueueTags"
      ],
      "Resource": "arn:aws:sqs:eu-west-2:<account_id>:ff_prod_*"
    },
    {
      "Sid": "DynamoDbReadScoped",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:ListTagsOfResource"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-2:<account_id>:table/ff_prod_*"
    },
    {
      "Sid": "EventBridgeReadScoped",
      "Effect": "Allow",
      "Action": [
        "events:DescribeEventBus",
        "events:DescribeRule",
        "events:ListTargetsByRule",
        "events:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:events:eu-west-2:<account_id>:event-bus/ff_prod_*",
        "arn:aws:events:eu-west-2:<account_id>:rule/ff_prod_*"
      ]
    },
    {
      "Sid": "SqsListAndIdentity",
      "Effect": "Allow",
      "Action": [
        "sqs:ListQueues",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
